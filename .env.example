APP_NAME="AI Content Studio API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"

# Neon `dev` branch, pooled (PgBouncer) endpoint — used by the running API
DATABASE_URL="postgresql+asyncpg://user:password@ep-xxx-pooler.region.aws.neon.tech/contentstudio"
# Neon `dev` branch, direct endpoint — used only by Alembic migrations
DATABASE_URL_DIRECT="postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/contentstudio"
# Neon `test` branch, pooled endpoint — used by the test suite
TEST_DATABASE_URL="postgresql+asyncpg://user:password@ep-yyy-pooler.region.aws.neon.tech/contentstudio"
# Neon `test` branch, direct endpoint — used only by test-suite migrations
TEST_DATABASE_URL_DIRECT="postgresql+asyncpg://user:password@ep-yyy.region.aws.neon.tech/contentstudio"
REDIS_URL="redis://localhost:6379"

BACKEND_CORS_ORIGINS='["http://localhost:3000"]'
